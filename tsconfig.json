{
    "compilerOptions":{
        "target": "es2022",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types":["node"],
        "baseUrl":".",
        "paths": {
            "@config/*": ["src/config/*"],
            "@pages/*": ["src/pages/*"],
            "@support/*": ["src/support/*"],
            "@api/*": ["src/api/*"],
            "@utils/*": ["src/utils/*"]
        }
    },

    "include":["practice/**/*.ts","src/**/*.ts"]
}